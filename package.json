    "index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llama.cpp",
    "llamaserver",
    "ollama",
    "context-window",
    "llm-pi-ai",
    "context-overflow"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IYIcode/dsh-ctx-probe.git"
  },
  "bugs": {
    "url": "https://github.com/IYIcode/dsh-ctx-probe/issues"
  },
  "homepage": "https://github.com/IYIcode/dsh-ctx-probe#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
